# Server Environment
NODE_ENV=development
PORT=4000

# Database (Local MongoDB Community Server 8, no Docker)
MONGODB_URI=mongodb://127.0.0.1:27017/radiology
MONGODB_URI_TEST=mongodb://127.0.0.1:27017

# Security & Authentication
JWT_SECRET=change-me-replace-with-at-least-32-chars-random-secret
JWT_TTL_HOURS=12
PUBLIC_ID_SALT=replace-with-at-least-16-chars-random-salt
BCRYPT_COST=12
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true

# Engine & Catalog
ALLOW_REPEATS=false
CATALOG_FILE=ml/artifacts/catalog.json
CATALOG_IMAGE_DIR=data/catalog/images

# LLM Configuration (Gemini API / Cache-Only Offline Mode)
# Modes: cache-only (default offline) | fake (testing) | live (Gemini Interactions API)
LLM_MODE=cache-only
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_DAILY_REQUEST_BUDGET=16
LLM_MIN_INTERVAL_MS=13000
LLM_TIMEOUT_MS=60000
LLM_RATE_LIMIT_PER_USER_PER_HOUR=30
