{
  "name": "radiology-adaptive-trainer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev -w @radiology/api\" \"npm run dev -w @radiology/web\"",
    "lint": "eslint . && node scripts/check-rtl-classes.js",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "test": "vitest run",
    "test:workspaces": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "eval:simulation": "node scripts/eval-simulation.js",
    "eval:analysis": "node scripts/eval-analysis.js",
    "eval:questions": "node scripts/eval-questions.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vitest": "^4.1.12"
  }
}
